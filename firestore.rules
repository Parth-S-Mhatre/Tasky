rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Task storage: users/{uid}/tasks/{taskId}
    // Only the owner may access their own tasks.
    match /users/{uid}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && isValidTaskOnWrite();
    }
    // Allow listing/creating under user's own collection.
    // (Covers collection queries scoped to own UID.)
    match /users/{uid}/tasks {
      // Firestore rules don't gate list separately from per-doc reads;
      // per-doc rule above applies. Keep explicit for clarity.
      allow list: if request.auth != null && request.auth.uid == uid;
    }

    function isValidTaskOnWrite() {
      // On delete, no new data to validate.
      return request.method == 'delete' ||
        (
          request.resource.data.keys().hasAll(['title', 'priority', 'completed', 'dueDate', 'createdAt', 'updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 200
          && (!('description' in request.resource.data) || request.resource.data.description is string)
          && request.resource.data.priority in ['low', 'medium', 'high']
          && request.resource.data.completed is bool
          && request.resource.data.dueDate is timestamp
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
        );
    }
  }
}
