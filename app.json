{
  "expo": {
    "name": "Tasky",
    "slug": "tasky",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tasky",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tasky.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f3f98160-f09d-4c5b-9961-d11f941c3c58"
      }
    }
  }
}
