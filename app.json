{
  "expo": {
    "name": "Tasky",
    "slug": "tasky",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tasky",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "icon": "./assets/app-icon.png",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "com.tasky.app",
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "buildToolsVersion": "35.0.0",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FEFFFA"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "tasky"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f3f98160-f09d-4c5b-9961-d11f941c3c58"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f3f98160-f09d-4c5b-9961-d11f941c3c58"
    }
  }
}
